    },
    {
      "parameters": {
        "jsCode": "const original = items[0].json.original_message;\nconst reply = items[0].json.latest_reply.toLowerCase();\n\n// Extract\nconst thread_id = original.match(/Thread ID:\\s*([^\\n]+)/)[1].trim();\nconst name = original.match(/Name:\\s*([^\\n]+)/)[1].trim();\n\n// Status logic\nconst keywords = [\"done\", \"complete\", \"completed\", \"update\"];\n\nconst status = keywords.some(word => reply.includes(word))\n  ? \"done\"\n  : \"pending\";\n\nreturn [\n  {\n    json: {\n      thread_id,\n      name,\n      reply,\n      status\n    }\n  }\n];"
      },
