    {
      "parameters": {
        "jsCode": "let signup;\n\n// If signup_date is missing\nif (!$json.signup_date) {\n  return [{\n    json: {\n      ...$json,\n      current_day: null,\n      error: \"signup_date missing\"\n    }\n  }];\n}\n\n// If signup_date is a number (Excel format like 46106)\nif (typeof $json.signup_date === \"number\") {\n  signup = new Date(($json.signup_date - 25569) * 86400 * 1000);\n} else {\n  // If signup_date is string (like 2026-03-25)\n  signup = new Date($json.signup_date);\n}\n\n// If date is invalid\nif (isNaN(signup)) {\n  return [{\n    json: {\n      ...$json,\n      current_day: null,\n      error: \"invalid signup_date\"\n    }\n  }];\n}\n\n// Get today date\nconst today = new Date();\n\n// Calculate current day\nconst current_day = Math.floor((today - signup) / (1000 * 60 * 60 * 24));\n\n// Return result\nreturn [{\n  json: {\n    ...$json,\n    current_day\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        560
      ],
      "id": "3a4349b0-707f-445a-aaee-66e06672de87",
      "name": "Calculate User Onboarding Day"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 3
          },
          "conditions": [
            {
              "id": "9844625c-210e-4868-b9af-1a9a0a2d3f23",
              "leftValue": "={{ $json.last_onboarding_email }}",
              "rightValue": "={{ $now.format('yyyy-MM-dd') }}",
              "operator": {
                "type": "dateTime",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
