      "id": "7cf149ab-f0a7-47b9-ad79-a9e08cb8047e",
      "name": "Check Email Not Sent Today",
      "alwaysOutputData": false,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n\n  const day = Number(item.json.current_day);\n  const login = Number(item.json.login_count || 0);\n  const setup = String(item.json.setup_completed).toLowerCase() === \"true\";\n  const lastEmailType = item.json.last_email_type || null;\n  const supportCount = Number(item.json.support_count || 0);\n\n  const emailMap = {\n    0: \"welcome\",\n    1: \"setup_guide\",\n    2: \"login_nudge\",\n    3: \"video_1\",\n    5: \"video_2\",\n    7: \"resources\",\n    10: \"activation_check\",\n    14: \"activation_final\",\n    21: \"use_case\",\n    30: \"checkin\"\n  };\n\n  let email_type = null;\n  let onboarding_status = item.json.onboarding_status || \"Active\";\n\n  // 🚨 1. PAUSE LOGIC (User struggling)\n  if (supportCount > 2) {\n    onboarding_status = \"Paused\";\n    email_type = null;\n  }\n\n  //  2. COMPLETION LOGIC\n  else if (day >= 30) {\n    onboarding_status = \"Completed\";\n    email_type = \"checkin\";\n  }\n\n  // 🔥 3. BEHAVIOR LOGIC (SMART CONTROL)\n  else if (login === 0 && day > 3 && lastEmailType !== \"login_nudge\") {\n    email_type = \"login_nudge\";\n  }\n\n  else if (!setup && day > 7 && lastEmailType !== \"activation_check\") {\n    email_type = \"activation_check\";\n  }\n\n  //  4. DEFAULT DAY-BASED FLOW\n  else {\n    email_type = emailMap[day] || null;\n  }\n\n  return {\n    json: {\n      ...item.json,\n      email_type,\n      onboarding_status,\n      last_email_type: email_type\n    }\n  };\n});"
      },
