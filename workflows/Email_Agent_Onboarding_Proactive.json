    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"subject\": \"your subject here\",\n  \"response\": \"<html formatted email>\"\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
